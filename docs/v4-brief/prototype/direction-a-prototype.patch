+@keyframes blink { 50% { opacity: 0; } }
+
+@media (max-width: 760px) {
+  .hero4 { left: 16px; right: 16px; top: auto; bottom: 16px; transform: none; padding: 22px; border-radius: var(--t-radius); background: var(--t-panel); color: var(--t-panel-ink); box-shadow: var(--t-shadow); backdrop-filter: var(--t-blur); max-width: none; }
+  .hero4.hero-hidden { transform: translateY(12px); }
+  .hero4 :is(.hero4-title, .hero4-text, .hero4-secondary) { color: var(--t-panel-ink); }
+  .hero4-title { font-size: 44px; margin-bottom: 10px; }
+  html[data-theme='b'] .hero4-title { font-size: 58px; }
+  .hero4-text, html[data-theme='b'] .hero4-text { font-size: 16px; margin-bottom: 18px; }
+  .hero4-role { font-size: 13px; margin-bottom: 8px; }
+  .hero4-primary { flex: 1; }
+}
+
+/* Panneaux et HUD : une seule famille de surfaces */
+html:not([data-theme='current']) :is(.location-label, .interaction, .map-pill, .controls-hint, .interior-title, .exit-interior, .journey-caption, .discover-action, .loading, .notice, .transition-caption, .station-nav button, .quick-nav button) {
+  background: var(--t-panel) !important;
+  color: var(--t-panel-ink) !important;
+  border: 1px solid var(--t-border) !important;
+  border-radius: var(--t-radius) !important;
+  box-shadow: var(--t-shadow) !important;
+  backdrop-filter: var(--t-blur);
+  font-family: var(--t-ui);
+}
+html:not([data-theme='current']) :is(.controls-hint, .map-pill, .exit-interior, .station-nav button, .journey-caption, .interaction, .discover-action) { font-size: 13px !important; }
+html:not([data-theme='current']) .location-label strong { font-family: var(--t-display); font-size: 20px; }
+html[data-theme='b'] .location-label strong { font-size: 26px; font-weight: 400; }
+html:not([data-theme='current']) :is(.quick-nav button.active, .station-nav button.active) { background: var(--t-accent) !important; color: var(--t-accent-ink) !important; }
