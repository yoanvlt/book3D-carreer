--- /dev/null
+++ b/src/theme.css
@@ -0,0 +1,147 @@
+/* Prototype V4 — trois directions d'interface, activées par ?theme=a|b|c.
+   Les règles ne s'appliquent pas au rendu actuel (data-theme="current"). */
+
+html[data-theme='a'] {
+  --t-display: 'Bricolage Grotesque Variable', system-ui, sans-serif;
+  --t-ui: 'Bricolage Grotesque Variable', system-ui, sans-serif;
+  --t-ink: #1f2b33;
+  --t-muted: #50606b;
+  --t-hero-ink: #14222c;
+  --t-panel: #ffffff;
+  --t-panel-ink: #1f2b33;
+  --t-border: transparent;
+  --t-accent: #ff5a2c;
+  --t-accent-ink: #ffffff;
+  --t-accent-shade: #c63f17;
+  --t-radius: 16px;
+  --t-shadow: 0 4px 0 #1f2b3314, 0 12px 30px #1d4f7026;
+  --t-blur: none;
+}
+html[data-theme='b'] {
+  --t-display: 'Instrument Serif', Georgia, serif;
+  --t-ui: 'JetBrains Mono Variable', ui-monospace, monospace;
+  --t-ink: #fff1e2;
+  --t-muted: #f3cfb0;
+  --t-hero-ink: #fff4e6;
+  --t-panel: #1d1830cc;
+  --t-panel-ink: #fff1e2;
+  --t-border: #ffc89a40;
+  --t-accent: #ffb066;
+  --t-accent-ink: #1d1830;
+  --t-accent-shade: #d9853f;
+  --t-radius: 3px;
+  --t-shadow: 0 18px 40px #120c2059;
+  --t-blur: blur(10px);
+}
+html[data-theme='c'] {
+  --t-display: 'JetBrains Mono Variable', ui-monospace, monospace;
+  --t-ui: 'JetBrains Mono Variable', ui-monospace, monospace;
+  --t-ink: #d6e2ff;
+  --t-muted: #8ea3cc;
+  --t-hero-ink: #e9f0ff;
+  --t-panel: #0a1224e8;
+  --t-panel-ink: #d6e2ff;
+  --t-border: #2c406a;
+  --t-accent: #5ee6c8;
+  --t-accent-ink: #04141a;
+  --t-accent-shade: #2fb398;
+  --t-radius: 0;
+  --t-shadow: 0 0 0 1px #5ee6c81a, 0 20px 40px #00000066;
+  --t-blur: blur(6px);
+}
+
+html:not([data-theme='current']) {
+  --ink: var(--t-ink);
+  --paper: var(--t-panel);
+  --coral: var(--t-accent);
+}
+html:not([data-theme='current']) :root,
+html:not([data-theme='current']) body,
+html:not([data-theme='current']) .app { font-family: var(--t-ui); color: var(--t-ink); }
+html[data-theme='a'] { background: #8fd0ea; }
+html[data-theme='b'] { background: #c86d4b; }
+html[data-theme='c'] { background: #0a1224; }
+
+/* Suppression des ornements « éditoriaux » */
+html:not([data-theme='current']) :is(.header-caption, .world-note, .home-footer, .hero-hint, .button-arrow, .tiny-sun, .hero-rule, .quick-title) { display: none !important; }
+html:not([data-theme='current']) .app:after { display: none; }
+html:not([data-theme='current']) .eyebrow { letter-spacing: 0; text-transform: none; font-size: 12px; font-weight: 500; color: var(--t-muted); }
+
+/* En-tête */
+html:not([data-theme='current']) .brand { font-family: var(--t-display); letter-spacing: 0; font-weight: 700; }
+html[data-theme='b'] .brand { font-weight: 400; font-size: 28px; }
+html[data-theme='c'] .brand { font-size: 18px; }
+html:not([data-theme='current']) .is-home .topbar { color: var(--t-hero-ink); }
+html:not([data-theme='current']) :is(.text-button, .help-button) { font-size: 14px; }
+html:not([data-theme='current']) .help-button { border-color: currentColor; }
+
+/* Accueil */
+.hero4 { max-width: 520px; }
+.hero4-role { font-size: 15px; margin: 0 0 14px; color: var(--t-muted); font-weight: 500; }
+.hero4-title { font-family: var(--t-display); color: var(--t-hero-ink); margin: 0 0 18px; line-height: .95; letter-spacing: -2px; font-size: clamp(56px, 6.4vw, 104px); font-weight: 800; }
+.hero4-text { font-size: 18px; line-height: 1.5; margin: 0 0 32px; color: var(--t-hero-ink); opacity: .86; max-width: 30ch; }
+.hero4-actions { display: flex; gap: 12px; align-items: center; }
+.hero4 button { pointer-events: auto; }
+.hero4-primary { background: var(--t-accent); color: var(--t-accent-ink); font-size: 16px; font-weight: 700; padding: 16px 28px; border-radius: var(--t-radius); transition: transform .15s; }
+.hero4-primary:hover { transform: translateY(-2px); }
+.hero4-secondary { color: var(--t-hero-ink); font-size: 16px; padding: 16px 20px; border-radius: var(--t-radius); border: 1.5px solid currentColor; }
+.hero4-keys { margin-top: 26px; font-size: 13px; color: var(--t-hero-ink); opacity: .75; display: flex; gap: 8px; align-items: center; }
+.hero4-keys kbd { border: 1px solid currentColor; border-radius: 4px; padding: 1px 6px; font-size: 11px; margin-left: 6px; }
+.hero4-keys kbd:first-child { margin-left: 0; }
+
+html[data-theme='a'] .hero4-primary { box-shadow: 0 5px 0 var(--t-accent-shade); border-radius: 999px; }
+html[data-theme='a'] .hero4-primary:active { transform: translateY(3px); box-shadow: 0 2px 0 var(--t-accent-shade); }
+html[data-theme='a'] .hero4-secondary { border-radius: 999px; background: #ffffffb3; border-color: transparent; }
+html[data-theme='a'] .hero4-title { letter-spacing: -3px; }
+
+html[data-theme='b'] .hero4-title { font-weight: 400; font-style: italic; letter-spacing: -1px; font-size: clamp(72px, 8vw, 132px); }
+html[data-theme='b'] .hero4-role { font-size: 13px; color: var(--t-accent); }
+html[data-theme='b'] .hero4-text { font-family: var(--t-display); font-size: 26px; line-height: 1.25; }
+html[data-theme='b'] .hero4 { text-shadow: 0 2px 30px #2a14304d; }
+
+html[data-theme='c'] .hero4-title { font-weight: 700; letter-spacing: -2px; font-size: clamp(48px, 5vw, 80px); }
+html[data-theme='c'] .hero4-title::after { content: '_'; color: var(--t-accent); animation: blink 1.1s steps(1) infinite; }
+html[data-theme='c'] .hero4-role { color: var(--t-accent); font-size: 14px; }
+html[data-theme='c'] .hero4-role::before { content: '> '; }
