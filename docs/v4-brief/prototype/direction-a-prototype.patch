+
+/* Dialogues */
+html:not([data-theme='current']) .dialog { background: var(--t-panel); color: var(--t-panel-ink); border: 1px solid var(--t-border); border-radius: calc(var(--t-radius) * 1.5); backdrop-filter: blur(16px); }
+html[data-theme='b'] .dialog { background: #1d1830f2; }
+html[data-theme='c'] .dialog { background: #0a1224f5; }
+html:not([data-theme='current']) .dialog :is(h2, .presentation-heading h2) { font-family: var(--t-display); letter-spacing: -.5px; }
+html:not([data-theme='current']) .primary { background: var(--t-accent); color: var(--t-accent-ink); border-radius: var(--t-radius); justify-content: center; }
+html:not([data-theme='current']) .detail-description { font-size: 16px; line-height: 1.6; }
